# Copy this file to .env for local development. Never commit .env.

# Turn on only for local development.
DEBUG=True

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# PostgreSQL connection string (local PostgreSQL, Render, or Supabase).
# SQLite is not supported.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wedsync

# Set to True for Supabase or any external database that requires SSL.
DATABASE_SSL_REQUIRE=False

# Comma-separated host names this site may be served from.
ALLOWED_HOSTS=localhost,127.0.0.1
